{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Jwt": {
    "Issuer": "CodeCraftNet",
    "Audience": "CodeCraftNet.Client",
    "ExpiryMinutes": 120
  },
  "AI": {
    "Ollama": {
      "Enabled": false
    }
  },
  "Execution": {
    "Runner": {
      "Enabled": true,
      "BaseUrl": "http://runner:8080",
      "TimeoutSeconds": 90
    }
  },
  "Swagger": {
    "Enabled": false
  },
  "AllowedHosts": "*"
}
