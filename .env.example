# Copy to .env and fill in real values before deploying. Never commit the
# resulting .env file (it is already gitignored).
#
# Local dev with plain `docker compose up`: every one of these has a dev-safe
# default baked into docker-compose.yml, so .env is optional there.
#
# Production with `docker compose -f docker-compose.yml -f docker-compose.prod.yml up`:
# docker-compose.prod.yml requires DB_PASSWORD, JWT_SECRET and CORS_ORIGIN to be
# set (no fallback), so this file becomes mandatory.

# --- Required in production ---

# Postgres password. Generate with: openssl rand -base64 24
DB_PASSWORD=

# JWT signing secret, 32+ random chars. Generate with: openssl rand -base64 48
JWT_SECRET=

# Public origin the frontend is served from, e.g. https://codecraftnet.example.com
# Used both for the CORS allow-list and (if you proxy through nginx) as the
# public URL.
CORS_ORIGIN=

# --- Optional overrides ---

# Account(s) that receive the Admin claim (question/challenge authoring, AI generation).
ADMIN_EMAIL=admin@codecraftnet.local

# Host ports (change if they collide with something else on the host).
DB_PORT=5432
API_PORT=5000
WEB_PORT=8080

# Local/host-side Ollama for optional AI coaching feedback and question generation.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b
